---
import { site } from '../lib/site';
const [first, ...rest] = site.name.match(/[A-Z][a-z0-9]*|[a-z0-9]+/g) ?? [site.name];
---
<span class="logo">
  <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <circle class="lm-ring" cx="16" cy="16" r="13" fill="none" stroke-width="2.2" />
    <circle class="lm-ring-in" cx="16" cy="16" r="9.5" fill="none" stroke-width="1.4" stroke-dasharray="2.4 2" />
    <path class="lm-tick" d="M10.5 16.5l3.8 3.8 7.2-8.6" fill="none" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="brand-name"><em>{first}</em>{rest.join('')}</span>
</span>
