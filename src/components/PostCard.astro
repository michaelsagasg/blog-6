---
import { fmtDate, postUrl, readingTime, catLabel, catTone, catSymbol, type Post } from '../lib/site';
interface Props { post: Post; level?: 2 | 3; cat?: boolean }
const { post, level = 3, cat = true } = Astro.props;
const c = post.data.category;
const H = `h${level}` as 'h2' | 'h3';
---
<li class={`item t-${catTone(c)}`} data-cat={c} data-text={`${post.data.title} ${post.data.description} ${c}`.toLowerCase()}>
  {cat && <p class="kicker"><b>{catSymbol(c)}</b>{catLabel(c)}</p>}
  <H><a href={postUrl(post)}>{post.data.title}</a></H>
  <p class="desc">{post.data.description}</p>
  <p class="meta"><time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time> · {readingTime(post)} min read</p>
</li>
