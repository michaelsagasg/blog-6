---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import HeroArt from '../components/HeroArt.astro';
import { site, getPosts, countBy, catLabel, catBlurb, catTone, catSymbol, fmtDate, withBase, bannerHref, orgJsonLd } from '../lib/site';
const posts = await getPosts();
const cats = countBy(posts, (p) => p.data.category);
const lead = posts[0];
const b = site.banner;
---
<Base title={site.name} description={site.tagline || undefined} jsonLd={orgJsonLd(Astro.site!)}>
  <section class="hero">
    <div class="wrap hero-in">
      <div class="cover">
        <p class="cover-eyebrow">Guide index</p>
        {lead && <p class="dateline">Updated {fmtDate(lead.data.date)}</p>}
        <h1>How to check a retatrutide or tirzepatide seller before you order</h1>
        <p class="hero-sub">A COA that matches the batch, a supplier who answers questions, delivery that's actually cold. What to verify before you hand over a card number.</p>
        <div class="hero-cta">
          {b.enabled && <a class="btn-shop" href={bannerHref(b.url)} rel="sponsored noopener">{b.button} <span aria-hidden="true">→</span></a>}
          <a class="btn-ghost" href="#all">Browse the checks</a>
        </div>
      </div>
      <HeroArt />
    </div>
  </section>

  <section class="wrap checklist-sec" aria-labelledby="topics">
    <h2 id="topics" class="sec-title">Sections in this file</h2>
    <ul class="checklist">
      {cats.map(([c, n]) => (
        <li>
          <a class={`chk t-${catTone(c)}`} href={withBase(`/category/${c}/`)}>
            <span class="chk-box" aria-hidden="true">
              <svg viewBox="0 0 20 20"><rect x="1.5" y="1.5" width="17" height="17" rx="3" fill="none" stroke-width="2" /><path d="M5 10.5l3 3.2 7-8" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <span class="chk-body">
              <span class="chk-label"><b>{catSymbol(c)}</b>{catLabel(c)}</span>
              <span class="chk-blurb">{catBlurb(c)}</span>
            </span>
            <span class="chk-n">{n} guides</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {b.enabled && (
    <section class="shopband" aria-label="Shop">
      <div class="wrap shopband-in">
        <a class="stamp-cta" href={bannerHref(b.url)} rel="sponsored noopener">
          <svg class="stamp-cta-ring" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <circle cx="24" cy="24" r="20" fill="none" stroke-width="2.5" />
            <circle cx="24" cy="24" r="14.5" fill="none" stroke-width="1.2" stroke-dasharray="2.6 2.6" />
            <path d="M15.5 24.5l5.5 6 12-14" fill="none" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="stamp-cta-text"><strong>{b.button}</strong><small>{b.headline}</small></span>
          <span class="stamp-cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )}

  <section class="wrap report-sec" data-filter-root data-limit="14" aria-labelledby="all">
    <div class="lib-head">
      <h2 id="all" class="sec-title">The full report</h2>
      <form class="search" role="search" onsubmit="return false">
        <input type="search" data-search placeholder="Search, for example COA or red flags" aria-label="Search articles" autocomplete="off" />
      </form>
    </div>
    <ul class="filters" aria-label="Filter by topic">
      <li><button type="button" data-chip="all" aria-pressed="true">All <span>{posts.length}</span></button></li>
      {cats.map(([cat, n]) => <li><button class={`t-${catTone(cat)}`} type="button" data-chip={cat} aria-pressed="false"><b>{catSymbol(cat)}</b>{catLabel(cat)} <span>{n}</span></button></li>)}
    </ul>
    <ol class="list report">{posts.map((p) => <PostCard post={p} />)}</ol>
    <p class="empty" data-empty hidden>No articles match that search. Try a different word.</p>
    <div class="more"><button class="btn" type="button" data-more hidden>Show <span>more</span> more articles</button></div>
  </section>
</Base>
